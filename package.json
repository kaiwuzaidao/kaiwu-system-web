{
  "name": "kaiwu-system-web",
  "version": "0.3.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Kaiwu 平台管理前端",
  "scripts": {
    "dev": "max dev",
    "build": "max build",
    "typecheck": "tsc --noEmit",
    "check:dict": "node scripts/check-dict-consistency.mjs",
    "check:security-pins": "node scripts/check-security-pins.mjs",
    "check:dict-usage": "node scripts/check-dict-usage.mjs",
    "check:i18n": "node scripts/check-i18n-consistency.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:perm": "node scripts/check-permission-consistency.mjs",
    "check:log": "node scripts/check-log-redaction.mjs",
    "check:licenses": "pnpm licenses list --prod --json | node scripts/check-license-policy.mjs",
    "format": "prettier --write \"{config,scripts,src,tests}/**/*.{js,mjs,ts,tsx}\" \"*.{js,json,ts}\"",
    "format:check": "prettier --check \"{config,scripts,src,tests}/**/*.{js,mjs,ts,tsx}\" \"*.{js,json,ts}\"",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "verify": "pnpm typecheck && pnpm check:i18n && pnpm check:architecture && pnpm check:log && pnpm check:dict && pnpm check:security-pins && pnpm check:perm && pnpm test:e2e:types && pnpm format:check && pnpm build && pnpm check:licenses",
    "licenses:prod": "pnpm licenses list --prod",
    "test:e2e": "playwright test",
    "test:e2e:types": "tsc --project tsconfig.e2e.json",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "setup": "max setup",
    "postinstall": "max setup"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "@ant-design/pro-components": "^2.8.2",
    "@ant-design/x": "1.6.1",
    "@umijs/max": "^4.6.82",
    "antd": "^5.22.2",
    "dayjs": "1.11.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "dotenv": "^17.4.2",
    "prettier": "3.9.6",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "@umijs/max>@umijs/lint": "-",
      "@umijs/max>eslint": "-",
      "@umijs/max>stylelint": "-",
      "@umijs/preset-umi>@stagewise/toolbar": "-",
      "@umijs/preset-umi>@umijs/bundler-mako": "-",
      "@umijs/bundler-vite>vite": "6.4.4",
      "@umijs/preset-umi>path-to-regexp": "1.9.0",
      "@ant-design/pro-layout>path-to-regexp": "8.4.0",
      "isomorphic-fetch>node-fetch": "2.6.7",
      "brace-expansion": "5.0.11",
      "fast-uri": "3.1.7",
      "follow-redirects": "1.16.2",
      "js-yaml": "3.15.2",
      "less": "4.8.1",
      "svgo": "2.8.4",
      "nanoid": "3.3.18",
      "@umijs/preset-umi>@umijs/bundler-utoopack": "-",
      "@umijs/preset-umi>@umijs/history": "-",
      "axios": "0.34.0",
      "immer": "9.0.21",
      "probe-image-size": "7.4.0",
      "source-map-js": "1.2.2"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  },
  "packageManager": "pnpm@10.8.0"
}

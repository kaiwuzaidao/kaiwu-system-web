# 可访问的前端地址；本机开发服务器与 Compose 默认使用 http://127.0.0.1:8000。
E2E_BASE_URL=http://127.0.0.1:8000

# 为只读后台验收和登录/登出验收配置专用管理员账号。密码只存本机 .env.e2e 或 CI Secret。
E2E_ADMIN_USERNAME=admin
E2E_ADMIN_PASSWORD=

# 只有连接到每次运行后会重置的隔离测试库时，才允许打开。
# 该组测试会创建用户、项目、角色和菜单；项目生成更不可逆。
E2E_ALLOW_MUTATIONS=false
E2E_ALLOW_GENERATION=false
